[Unit]
Description=VulTrack Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vultrack-agent
Group=vultrack-agent
ExecStart=/usr/local/bin/vultrack-agent daemon
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/vultrack-agent /var/lib/vultrack-agent
# Runtime facts: CAP_DAC_READ_SEARCH and CAP_SYS_PTRACE let the agent read
# other processes' /proc entries (fd, maps, exe, ns) for the listeners and
# packagesInUse collectors. Without them both are reported as "insufficient
# privileges". The syscalls that would turn CAP_SYS_PTRACE into access to
# other processes' memory are blocked below.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
# AF_UNIX is needed by systemctl (services collector).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallFilter=@system-service
SystemCallFilter=~ptrace process_vm_readv process_vm_writev pidfd_getfd
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
