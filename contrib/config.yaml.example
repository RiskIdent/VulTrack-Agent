# VulTrack Agent Configuration
# This file should be placed at /etc/vultrack-agent/config.yaml

# VulTrack server URL (required)
server_url: https://vultrack.example.com

# Enrollment key for registration (required).
# IMPORTANT: Keep this value in the config permanently.
# It is used for initial enrollment and for automatic re-enrollment when the
# refresh token expires or is revoked — without it the agent cannot recover
# autonomously.
enrollment_key: ""

# Path to persist the refresh token on disk (default: /var/lib/vultrack-agent/refresh.token)
# The access token is held in memory only and is never written to disk.
refresh_token_file: /var/lib/vultrack-agent/refresh.token

# How often to send reports in daemon mode (default: 1h)
# Examples: 30m, 1h, 2h, 24h
report_interval: 1h

# Log level: debug, info, warn, error (default: info)
log_level: info

# Path to log file (empty = stdout)
log_file: ""

# Skip TLS certificate verification (default: false)
# WARNING: Only use for testing!
insecure: false

# Path to custom CA certificate file (optional)
# ca_cert: /etc/ssl/certs/custom-ca.crt

# --- Runtime facts -----------------------------------------------------------
# The agent adds runtime facts to every report: loaded kernel modules, listening
# sockets, packages in use by running processes, systemd services and a few
# kernel settings. The server uses them to rule out vulnerabilities that cannot
# affect this host. See the README section "Runtime Facts".

# Master switch (default: true). false omits the runtime facts entirely.
collect_runtime: true

# Which collectors run (default: all). A collector that is not listed is
# reported as unknown, not as empty.
runtime_collectors:
  - kernel
  - listeners
  - packages_in_use
  - services
  - virtualization

# Overall time budget for all collectors in seconds (default: 20)
runtime_timeout_seconds: 20

# Hash of the last kernel module index the server accepted. The full index
# (several thousand lines) is only sent when it changed or once a day.
module_index_state_file: /var/lib/vultrack-agent/module-index.sha256
